{
  "openapi": "3.1.0",
  "info": {
    "title": "Audit FitSM API",
    "version": "0.1.0",
    "description": "Spec-first API for FitSM assessment and audit lifecycle."
  },
  "servers": [
    {
      "url": "http://localhost:1261"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "audit_fitsm_session",
        "description": "HttpOnly, SameSite=Strict session cookie set by POST /auth/login (Secure in production/staging). Bearer tokens are not accepted."
      }
    },
    "schemas": {
      "Audit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "org_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "audit_date_UTC": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {}
        }
      },
      "SessionOk": {
        "type": "object",
        "required": ["ok", "expiresInSec"],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [true]
          },
          "expiresInSec": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "parameters": {
      "CsrfHeader": {
        "name": "x-audit-fitsm",
        "in": "header",
        "required": true,
        "description": "CSRF guard. Required (value `1`) on every POST, PUT, PATCH and DELETE, including login and logout; requests without it get 403.",
        "schema": {
          "type": "string",
          "enum": ["1"]
        }
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check (DB + migrations)",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login with local credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in. The session is only in the Set-Cookie header; the body carries no token.",
            "headers": {
              "Set-Cookie": {
                "description": "audit_fitsm_session=<jwt>; HttpOnly; SameSite=Strict; Path=/; Max-Age=<ttl>",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOk"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or malformed payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing CSRF header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts (per IP: 30 per 15 min; per email: 10 per 15 min)",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ]
      }
    },
    "/me": {
      "get": {
        "summary": "Current user profile and org roles",
        "responses": {
          "200": {
            "description": "Authenticated profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sub": {
                      "type": "integer"
                    },
                    "email": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "orgRoles": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "tokenVersion": {
                      "type": "integer"
                    },
                    "authVia": {
                      "type": "string",
                      "enum": ["cookie"]
                    },
                    "sessionExpiresAt": {
                      "type": ["string", "null"],
                      "format": "date-time",
                      "description": "Session expiry in UTC, ISO 8601 with Z (e.g. 2026-11-08T14:05:09Z)"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/clients": {
      "get": {
        "summary": "List accessible clients (organizations)",
        "responses": {
          "200": {
            "description": "Client list"
          }
        }
      },
      "post": {
        "summary": "Create new client (system admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Forbidden, or missing CSRF header"
          },
          "400": {
            "description": "Invalid or malformed payload"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ]
      }
    },
    "/roles": {
      "get": {
        "summary": "List assignable roles",
        "responses": {
          "200": {
            "description": "Role list"
          }
        }
      }
    },
    "/orgs/{orgId}/users": {
      "get": {
        "summary": "List users and roles for an organization",
        "parameters": [
          {
            "name": "orgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization user list"
          }
        }
      },
      "post": {
        "summary": "Create local user and assign org roles",
        "parameters": [
          {
            "name": "orgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Forbidden, or missing CSRF header"
          },
          "400": {
            "description": "Invalid or malformed payload"
          },
          "409": {
            "description": "Email belongs to a system administrator or a user of another client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/{orgId}/users/{userId}/roles": {
      "put": {
        "summary": "Replace organization roles for one user",
        "parameters": [
          {
            "name": "orgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          },
          "403": {
            "description": "Not an org admin, system_admin requested, target is a system administrator, or missing CSRF header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or malformed payload"
          }
        }
      }
    },
    "/orgs/{orgId}/audits": {
      "get": {
        "summary": "List organization audits",
        "parameters": [
          {
            "name": "orgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audits list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Audit"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create organization audit",
        "parameters": [
          {
            "name": "orgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "auditDate"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "auditDate": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Forbidden, or missing CSRF header"
          },
          "400": {
            "description": "Invalid or malformed payload"
          },
          "409": {
            "description": "An audit with this name already exists for this client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/audits/{auditId}/status": {
      "put": {
        "summary": "Update audit status with transition rules",
        "parameters": [
          {
            "name": "auditId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["draft", "in_progress", "completed"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "409": {
            "description": "Invalid transition, or the status changed concurrently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden, or missing CSRF header"
          },
          "400": {
            "description": "Invalid or malformed payload"
          }
        }
      }
    },
    "/audits/{auditId}/results/all": {
      "get": {
        "summary": "All results view",

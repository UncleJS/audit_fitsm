    },
    "/auth/refresh": {
      "post": {
        "summary": "Re-issue the session cookie with a fresh expiry",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Session renewed",
            "headers": {
              "Set-Cookie": {
                "description": "audit_fitsm_session=<jwt>; HttpOnly; SameSite=Strict; Path=/; Max-Age=<ttl>",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOk"
                }
              }
            }
          },
          "401": {
            "description": "No valid session (cookie cleared)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing CSRF header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Log out and revoke every session of the user",
        "description": "Bumps the user's token version, so all outstanding session cookies stop working, then clears the cookie. Succeeds without a session too.",
        "security": [
          {},
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing CSRF header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }

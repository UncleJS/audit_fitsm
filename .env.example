# Audit FitSM environment reference.
#
# The Quadlet units in quadlet/ set these for the dev container. This file only
# documents them; it is not loaded automatically. Copy it to .env for local
# tooling if needed (.env is gitignored and excluded from the image).
#
# Secrets are NOT set here. scripts/install.sh creates these Podman secrets with
# random values and the units inject them as env vars:
#   audit-fitsm-db-password       -> DB_PASSWORD (dev), MARIADB_PASSWORD (db)
#   audit-fitsm-db-root-password  -> MARIADB_ROOT_PASSWORD (db)
#   audit-fitsm-jwt-secret        -> JWT_SECRET (dev)
# Never commit real values. Default/placeholder secrets are rejected by the API.

# --- Database (MariaDB runs in the same pod; port 3306 is not published) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=audit_app
DB_NAME=audit_fitsm
# DB_PASSWORD=<from podman secret audit-fitsm-db-password>

# --- API ---
APP_PORT=1261
# JWT_SECRET=<from podman secret audit-fitsm-jwt-secret>
JWT_TTL_SEC=900
EXPORTS_DIR=/workspace/data/exports
BACKUPS_DIR=/workspace/data/backups
CORS_ALLOWED_ORIGINS=http://127.0.0.1:1260,http://localhost:1260
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
TZ=UTC

# --- Web ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:1261
API_BASE_URL=http://127.0.0.1:1261

# --- Admin bootstrap (scripts/bootstrap-admin.sh prompts if unset; min 12 chars) ---
# BOOTSTRAP_ADMIN_PASSWORD=<choose-at-least-12-chars>

# --- Readiness / integration checks ---
WEB_BASE_URL=http://127.0.0.1:1260
TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=<the bootstrap admin password>
